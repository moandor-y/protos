CompileFlags:
  Add:
    - -std=c++20
    - -m64
    - -Wall
    - -Wextra

---
If:
  PathExclude: rbtree_test\.cpp
CompileFlags:
  Add:
    - -masm=intel
    - -ffreestanding
    - -fno-builtin
    - -fno-exceptions
    - -fno-rtti
    - -mno-red-zone
    - -fno-stack-protector
    - -fno-pie

---
If:
  PathMatch: rbtree_test\.cpp
CompileFlags:
  Add:
    - -isystem
    - build/include

